{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-assistant.local/schemas/style-profile-1.0.0.json",
  "title": "Video Style Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "editing", "audio", "graphics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "editing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_min_seconds", "shot_max_seconds", "default_transition", "avoid_jump_cuts"],
      "properties": {
        "shot_min_seconds": {"type": "number", "exclusiveMinimum": 0},
        "shot_max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "default_transition": {"enum": ["cut", "cross_dissolve", "fade_to_black"]},
        "avoid_jump_cuts": {"type": "boolean"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["music_level_db", "duck_level_db"],
      "properties": {
        "music_profile": {"type": ["string", "null"]},
        "music_level_db": {"type": "number", "minimum": -60, "maximum": 12},
        "duck_level_db": {"type": "number", "minimum": -60, "maximum": 12},
        "keep_natural_sound": {"type": "boolean"}
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_template_id", "ingredients_template_id", "subtitle_template_id"],
      "properties": {
        "title_template_id": {"type": "string", "minLength": 1},
        "ingredients_template_id": {"type": "string", "minLength": 1},
        "subtitle_template_id": {"type": "string", "minLength": 1}
      }
    },
    "color": {"type": "object", "additionalProperties": true},
    "camera": {"type": "object", "additionalProperties": true},
    "sound_design": {"type": "object", "additionalProperties": true}
  }
}

