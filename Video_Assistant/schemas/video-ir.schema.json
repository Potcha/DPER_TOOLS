{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-assistant.local/schemas/video-ir-1.0.0.json",
  "title": "Video IR",
  "description": "Vendor-neutral executable storyboard and video editing intermediate representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "scenes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {"$ref": "#/$defs/project"},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "durationRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_seconds", "max_seconds"],
      "properties": {
        "min_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "delivery", "style_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "style_id": {"type": "string", "minLength": 1},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "width", "height", "fps"],
          "properties": {
            "platform": {"enum": ["youtube", "youtube_shorts", "tiktok", "instagram_reels", "podcast_video"]},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "fps": {"type": "string", "pattern": "^[0-9]+(/[0-9]+)?$"},
            "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source_id": {"type": ["string", "null"]},
        "keep_complete_sentences": {"type": "boolean", "default": true},
        "optional": {"type": "boolean", "default": false}
      }
    },
    "visualNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "search_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "preferred_shots": {
          "type": "array",
          "items": {"enum": ["extreme_close_up", "close_up", "medium", "wide", "overhead", "screen_recording"]}
        },
        "shot_duration": {"$ref": "#/$defs/durationRange"},
        "required_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "optional_elements": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "purpose", "need"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "purpose": {"type": "string", "minLength": 1},
        "need": {"$ref": "#/$defs/visualNeed"},
        "min_candidates": {"type": "integer", "minimum": 1, "default": 1},
        "fallback": {"type": ["string", "null"]}
      }
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"enum": ["title", "chapter", "ingredient_list", "step_list", "lower_third", "call_to_action", "subtitle", "overlay"]},
        "text": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "recommended", "optional"], "default": "optional"},
        "start_seconds": {"type": ["number", "null"], "minimum": 0},
        "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "template_id": {"type": ["string", "null"]}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "profile_id": {"type": ["string", "null"]},
        "level_db": {"type": "number", "minimum": -60, "maximum": 12, "default": -20},
        "duck_level_db": {"type": ["number", "null"], "minimum": -60, "maximum": 12}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_priority": {"type": "boolean", "default": true},
        "keep_natural_sound": {"type": "boolean", "default": true},
        "music": {"$ref": "#/$defs/music"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["cut", "cross_dissolve", "fade_to_black", "fade_from_black", "whip", "zoom"]},
        "duration_frames": {"type": "integer", "minimum": 0, "default": 0}
      }
    },
    "editing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_seconds", "pace"],
      "properties": {
        "target_seconds": {"type": "number", "exclusiveMinimum": 0},
        "tolerance_seconds": {"type": "number", "minimum": 0, "default": 2},
        "pace": {"enum": ["slow", "steady", "energetic", "fast"]},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mandatory_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fallbacks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "provenance", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["scenario", "style", "user", "ai", "default"]},
        "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "intent", "requirement", "editing"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "intent": {"enum": ["intro", "hook", "presentation", "ingredients", "instruction", "transition", "result", "tasting", "outro"]},
        "requirement": {"enum": ["required", "recommended", "optional"]},
        "editing": {"$ref": "#/$defs/editing"},
        "narration": {"$ref": "#/$defs/narration"},
        "visual": {"$ref": "#/$defs/visualNeed"},
        "selections": {"type": "array", "items": {"$ref": "#/$defs/selection"}},
        "graphics": {"type": "array", "items": {"$ref": "#/$defs/graphic"}},
        "audio": {"$ref": "#/$defs/audio"},
        "constraints": {"$ref": "#/$defs/constraints"},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
      }
    }
  }
}

