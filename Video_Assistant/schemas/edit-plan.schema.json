{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-assistant.local/schemas/edit-plan-1.0.0.json",
  "title": "Portable Edit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "timeline_name", "fps", "operations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1},
    "timeline_name": {"type": "string", "minLength": 1},
    "fps": {"type": "string", "pattern": "^[0-9]+(/[0-9]+)?$"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "params"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "kind": {"enum": ["insert_clip", "trim_clip", "add_title", "add_overlay", "add_transition", "add_music", "set_volume", "add_subtitle", "apply_color_preset"]},
          "params": {"type": "object"},
          "source_scene_id": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]}
        }
      }
    }
  }
}

